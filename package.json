{
  "name": "render-dart",
  "version": "0.1.0",
  "description": "Write Render Workflows tasks in Dart, compiled to JavaScript and run by Render's official SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmaffett/render-dart.git"
  },
  "keywords": [
    "render",
    "workflows",
    "dart",
    "dart2js"
  ],
  "bin": {
    "render-dart": "src/cli.js"
  },
  "main": "src/runtime.js",
  "exports": {
    ".": "./src/runtime.js",
    "./runtime": "./src/runtime.js",
    "./toolchain": "./src/toolchain/index.js"
  },
  "files": [
    "src",
    "template",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "peerDependencies": {
    "@renderinc/sdk": ">=0.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
