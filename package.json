{
  "name": "render-dart",
  "version": "0.7.0",
  "description": "Unofficial: write Render Workflows tasks in Dart, compiled to JavaScript. Not affiliated with or endorsed by Render.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmaffett/render-dart.git"
  },
  "keywords": [
    "render",
    "workflows",
    "dart",
    "dart2js"
  ],
  "bin": {
    "render-dart": "src/cli.js"
  },
  "main": "src/runtime.js",
  "exports": {
    ".": "./src/runtime.js",
    "./runtime": "./src/runtime.js",
    "./toolchain": "./src/toolchain/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "runtime",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dart"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "peerDependencies": {
    "@renderinc/sdk": ">=0.5.0",
    "@bjorn3/browser_wasi_shim": ">=0.2.9"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependenciesMeta": {
    "@bjorn3/browser_wasi_shim": {
      "optional": true
    }
  }
}
